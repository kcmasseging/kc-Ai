KC_AI_ENV=development
KC_AI_PORT=3000
KC_AI_LOG_LEVEL=info
KC_AI_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
KC_AI_JWT_SECRET=replace-with-a-long-random-secret
KC_AI_SECRET_BUS_KEY=replace-with-at-least-32-random-characters
KC_AI_SECRET_BUS_PATH=.kc-ai-secrets.json
KC_AI_OWNER_ID=owner
KC_AI_OWNER_PASSWORD_HASH=
KC_AI_OWNER_INITIALIZATION_SECRET=
KC_AI_OWNER_BOOTSTRAP_PASSWORD=
KC_AI_TASK_STORE_PATH=.kc-ai-tasks.json
KC_AI_AUDIT_STORE_PATH=.kc-ai-audit.json
KC_AI_TASK_HISTORY_STORE_PATH=.kc-ai-task-history.json
KC_AI_WALLET_STORE_PATH=.kc-ai-wallets.json
KC_AI_STORAGE_DRIVER=local
KC_AI_DATABASE_URL=postgresql://kc_ai_user:replace-me@localhost:5432/kc_ai
KC_AI_DATABASE_SSL=false
KC_AI_TTS_PROVIDER=browser
KC_AI_TTS_VOICE=en-US-JennyNeural
KC_AI_ENABLE_VOICE=true
KC_AI_ENABLE_WELCOME=true
