KC_AI_ENV=development
KC_AI_PORT=3000
KC_AI_LOG_LEVEL=info
KC_AI_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
KC_AI_JWT_SECRET=replace-with-a-long-random-secret
KC_AI_SECRET_BUS_KEY=replace-with-at-least-32-random-characters
KC_AI_TASK_STORE_PATH=.kc-ai-tasks.json
KC_AI_TTS_PROVIDER=browser
KC_AI_TTS_VOICE=en-US-JennyNeural
KC_AI_ENABLE_VOICE=true
KC_AI_ENABLE_WELCOME=true
